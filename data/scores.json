  "evidence": {
    "us": [
      {
        "text": "HOST (1960s roots) replaced by ERAM at all 20 centers in 2015",
        "src": "faa_nextgen_acc"
      },
      {
        "text": "ADS-B nationwide by 2019; Data Comm en route at all 20 ARTCCs in 2025",
        "src": "faa_nextgen"
      },
      {
        "text": "2024: 51 of 138 systems unsustainable; copper lines unsupported by providers",
        "src": "gao26"
      },
      {
        "text": "BNATCS moved radio and voice-switch completion from 2037 to late 2028",
        "src": "gao26"
      },
      {
        "text": "As of Nov 2026: 71% of copper replaced, 230 of 450 voice switches, 16 of 612 radars",
        "src": "modernskies"
      },
      {
        "text": "En route centers 60 to 70 years old against a 50-year design life",
        "src": "rollcall"
      },
      {
        "text": "GAO: no reliable lifecycle cost estimate or integrated master schedule",
        "src": "gao26"
      }
    ],
    "sg": [
      {
        "text": "LORADS III (Thales TopSky) operational Oct 2013, planned for traffic to 2025",
        "src": "icao_lorads"
      },
      {
        "text": "Current system nearing end of life; NexGen ATMS due 2030, digital tower first operational 2030",
        "src": "caas_2026"
      },
      {
        "text": "S$4B upgrade program over 15 years",
        "src": "caas_2026"
      }
    ],
    "jp": [
