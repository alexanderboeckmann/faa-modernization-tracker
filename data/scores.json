  "criteria": [
    {
      "id": "auto",
      "name": "Core automation",
      "five": "Current-generation, trajectory-based en route and terminal platform, under 10 years old, one shared code base"
    },
    {
      "id": "telecom",
      "name": "Telecom backbone",
      "five": "All-IP, fiber/wireless/satellite with diverse routing; no legacy TDM copper"
    },
    {
      "id": "voice",
      "name": "Voice communications",
      "five": "IP voice switching and digital radios throughout; any frequency usable from any position"
    },
    {
      "id": "datalink",
      "name": "Controller-pilot data link",
      "five": "CPDLC routine in en route and tower clearance, high equipage"
    },
    {
      "id": "surv",
      "name": "Surveillance",
      "five": "Full ADS-B incl. space-based, MLAT and modern radar backup; no sensors past design life"
    },
    {
      "id": "surface",
      "name": "Surface and tower tools",
      "five": "Surface surveillance at all major airports, electronic strips, digital/remote towers in use"
    },
    {
      "id": "flow",
      "name": "Flow management and TBO",
      "five": "Network-wide AMAN/DMAN, collaborative flow management, trajectory-based operations live"
    },
    {
      "id": "facility",
      "name": "Facility age and condition",
      "five": "Centers and towers inside design life with no deferred-maintenance backlog"
    },
    {
      "id": "resil",
      "name": "Resilience",
      "five": "No multi-hour national outages; tested contingency centers; few unsustainable systems"
    },
    {
      "id": "delivery",
      "name": "Program delivery",
      "five": "Projects land near baseline cost and schedule, with transparent public reporting"
    }
  ],
